-- Support workflow: inspect collection shape, fetch an exact point, page through filtered data, recommend similar incidents.
CREATE COLLECTION support_incidents HYBRID
CREATE INDEX ON COLLECTION support_incidents FOR service TYPE keyword
CREATE INDEX ON COLLECTION support_incidents FOR priority TYPE keyword
INSERT BULK INTO COLLECTION support_incidents VALUES [
  {
    'id': 401,
    'text': 'API search pods restarted after vector cache saturation during a traffic spike.',
    'service': 'search-api',
    'priority': 'high'
  },
  {
    'id': 402,
    'text': 'Indexer backlog grew after embeddings endpoint timeout in the ingestion pipeline.',
    'service': 'ingest-worker',
    'priority': 'high'
  },
  {
    'id': 403,
    'text': 'Support note for a lower-priority dashboard rendering bug unrelated to retrieval.',
    'service': 'ops-dashboard',
    'priority': 'low'
  }
] USING HYBRID
SHOW COLLECTION support_incidents
SELECT * FROM support_incidents WHERE id = 401
SCROLL FROM support_incidents WHERE priority = 'high' AFTER 401 LIMIT 2
RECOMMEND FROM support_incidents POSITIVE IDS (401) LIMIT 2
