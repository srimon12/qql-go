-- Disposable CI smoke test for core QQL operations.
CREATE COLLECTION ci_smoke_docs HYBRID
CREATE INDEX ON COLLECTION ci_smoke_docs FOR category TYPE keyword
CREATE INDEX ON COLLECTION ci_smoke_docs FOR status TYPE keyword
INSERT BULK INTO COLLECTION ci_smoke_docs VALUES [
  {
    'id': 201,
    'text': 'Hybrid retrieval smoke test document for deployment validation.',
    'category': 'smoke',
    'status': 'active'
  },
  {
    'id': 202,
    'text': 'Rollback instructions for failed release validation.',
    'category': 'runbook',
    'status': 'active'
  },
  {
    'id': 203,
    'text': 'Archived test note for delete verification.',
    'category': 'smoke',
    'status': 'archived'
  }
] USING HYBRID
SEARCH ci_smoke_docs SIMILAR TO 'deployment validation' LIMIT 2 USING HYBRID
SEARCH ci_smoke_docs SIMILAR TO 'deployment validation' LIMIT 2 EXACT
RECOMMEND FROM ci_smoke_docs POSITIVE IDS (201) LIMIT 2
DELETE FROM ci_smoke_docs WHERE status = 'archived'
SHOW COLLECTION ci_smoke_docs
DROP COLLECTION ci_smoke_docs
