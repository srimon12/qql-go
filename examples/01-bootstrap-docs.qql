-- Bootstrap a hybrid docs collection with payload indexes and seed data.
CREATE COLLECTION example_docs HYBRID QUANTIZE TURBO BITS 2 ALWAYS RAM
CREATE INDEX ON COLLECTION example_docs FOR team TYPE keyword
CREATE INDEX ON COLLECTION example_docs FOR status TYPE keyword
CREATE INDEX ON COLLECTION example_docs FOR severity TYPE integer
CREATE INDEX ON COLLECTION example_docs FOR year TYPE integer
