CREATE COLLECTION medical_retrieval_ops HYBRID HNSW { payload_m: 16 } QUANTIZE SCALAR QUANTILE 0.99 ALWAYS RAM
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR specialty TYPE keyword
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR priority TYPE keyword
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR status TYPE keyword
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR year TYPE integer
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR patient_id TYPE keyword WITH { is_tenant: true, on_disk: true }
CREATE INDEX ON COLLECTION medical_retrieval_ops FOR diagnosis TYPE text WITH { tokenizer: 'word', min_token_len: 2, max_token_len: 20, lowercase: true, phrase_matching: true }
SHOW COLLECTION medical_retrieval_ops
