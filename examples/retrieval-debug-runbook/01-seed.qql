CREATE COLLECTION retrieval_debug_runbook HYBRID WITH HNSW (payload_m = 16)
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR team TYPE keyword
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR service TYPE keyword
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR severity TYPE keyword
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR doc_type TYPE keyword
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR status TYPE keyword
CREATE INDEX ON COLLECTION retrieval_debug_runbook FOR title TYPE text WITH (tokenizer = 'word', lowercase = true, phrase_matching = true)
