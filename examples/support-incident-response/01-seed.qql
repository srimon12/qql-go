CREATE COLLECTION support_incident_response HYBRID HNSW { payload_m: 16 }
CREATE INDEX ON COLLECTION support_incident_response FOR service TYPE keyword
CREATE INDEX ON COLLECTION support_incident_response FOR priority TYPE keyword
CREATE INDEX ON COLLECTION support_incident_response FOR status TYPE keyword
CREATE INDEX ON COLLECTION support_incident_response FOR region TYPE keyword
CREATE INDEX ON COLLECTION support_incident_response FOR title TYPE text WITH { tokenizer: 'word', lowercase: true, phrase_matching: true }
